# Make hidraw6 readable for the daemon (raw HID access)
# OWNER for non-system users is deprecated in modern systemd/udev
ACTION=="add|change", KERNEL=="hidraw*", ATTRS{idVendor}=="260d", ATTRS{idProduct}=="0015", ATTRS{bInterfaceNumber}=="01", MODE="0644"

# Tag the daemon's uinput device so the Wayland session gets access
ACTION=="add", SUBSYSTEM=="input", ATTR{phys}=="dareu-ek925-media/input0", TAG+="uaccess", TAG+="seat"
